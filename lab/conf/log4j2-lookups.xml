<?xml version="1.0" encoding="UTF-8"?>
<!-- From 2.15.0 on, %msg/%m does not perform lookups unless the pattern asks for it.
     This is the configuration an application gets if it opts back in with %msg{lookups}. -->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss} %-5level %logger{1} - %msg{lookups}%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="info">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
