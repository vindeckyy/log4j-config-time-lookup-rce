<?xml version="1.0" encoding="UTF-8"?>
<!-- Pattern resolves the Thread Context Map value; the returned value is substituted again,
     so a JNDI lookup inside an MDC value is evaluated. -->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%-5level %logger{1} - ${ctx:ua}%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="info">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
